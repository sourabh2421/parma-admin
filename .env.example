# Copy to .env and fill in from Firebase Console → Project settings → Your apps → Web app config.
# Vite exposes only variables prefixed with VITE_.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional client-side write guard (must match the admin user in Firebase Auth exactly).
# Also set the same address in firestore.rules (isAdmin) and deploy rules.
VITE_FIREBASE_ADMIN_EMAIL=

# Auth session persistence: `local` (default) or `session` (cleared when the browser tab session ends).
VITE_AUTH_PERSISTENCE=local
