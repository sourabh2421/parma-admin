rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Marksheet Portal: Real-time Periodic Exam Marks (FA-1 to SA-2) & Subjects Config
    match /marksheetRecords/{recordId} {
      allow read, write: if true;
    }
    match /marksheetConfig/{configId} {
      allow read, write: if true;
    }

    // Students Directory
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Fees & Fee Records
    match /fees/{feeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Legacy Single-Table Records
    match /studentFeeRecords/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
