rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'vatsalrai76652@gmail.com' ||
        request.auth.token.email == 'parma.academy.2004@gmail.com'
      );
    }

    function isFeeAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'office@parma.com' ||
        isSuperAdmin()
      );
    }

    function isMarksheetAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'teacher@parma.com' ||
        isSuperAdmin()
      );
    }

    // Marksheet Portal: Real-time Periodic Exam Marks (FA-1 to SA-2) & Subjects Config
    match /marksheetRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isMarksheetAdmin();
    }
    match /marksheetConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isMarksheetAdmin();
    }

    // Students Directory (read by both desks, modified by fee / super admin)
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isFeeAdmin();
    }

    // Fees & Fee Records (fee admin & super admin only)
    match /fees/{feeId} {
      allow read, write: if isFeeAdmin();
    }

    // Payments Collection (Auditable handover of money per transaction)
    match /payments/{paymentId} {
      allow read: if isFeeAdmin();
      allow create: if isFeeAdmin();
      allow update: if isFeeAdmin() && request.resource.data.status == 'void';
      allow delete: if false;
    }

    // Counters (Sequential receipt numbering)
    match /counters/{counterId} {
      allow read, write: if isFeeAdmin();
    }

    // Legacy Single-Table Records
    match /studentFeeRecords/{recordId} {
      allow read, write: if isFeeAdmin();
    }
  }
}
